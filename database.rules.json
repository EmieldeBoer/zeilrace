{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "races": {
      "$race": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",

        "claims": {
          "$boot": {
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
            ".validate": "newData.isString() && $boot.length <= 30"
          }
        },

        "positions": {
          "$boot": {
            ".write": "auth != null && root.child('races').child($race).child('claims').child($boot).val() === auth.uid",
            ".validate": "newData.hasChildren(['lat', 'lng', 'ts'])",
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "ts": { ".validate": "newData.isNumber()" },
            "acc": { ".validate": "newData.isNumber()" },
            "speed": { ".validate": "newData.isNumber()" },
            "heading": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "tracks": {
          "$boot": {
            "$punt": {
              ".write": "auth != null && !data.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid",
              ".validate": "newData.hasChildren(['lat', 'lng', 'ts'])",
              "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
              "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
              "ts": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        "times": {
          "$boot": {
            "start": {
              ".write": "auth != null && !data.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid",
              ".validate": "newData.isNumber() && (!root.child('races').child($race).child('raceStart').exists() || newData.val() >= root.child('races').child($race).child('raceStart').val())"
            },
            "finish": {
              ".write": "auth != null && !data.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid",
              ".validate": "newData.isNumber() && newData.parent().child('start').isNumber() && newData.val() > newData.parent().child('start').val()"
            },
            "$other": { ".validate": false }
          }
        },

        "rounded": {
          "$boot": {
            "$boei": {
              ".write": "auth != null && !data.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid",
              ".validate": "newData.isNumber() && $boei.length <= 24"
            }
          }
        },

        "names": {
          "$boot": {
            ".write": "auth != null && root.child('races').child($race).child('claims').child($boot).val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
          }
        },

        "voorstel": {
          ".validate": "newData.hasChildren(['id', 't', 'plan']) && newData.child('id').isNumber() && newData.child('t').isNumber() && !root.child('races').child($race).child('raceStart').exists()"
        },

        "akkoord": {
          "$boot": {
            ".write": "auth != null && newData.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid",
            ".validate": "newData.val() === root.child('races').child($race).child('voorstel').child('id').val() && root.child('races').child($race).child('voorstel').child('t').val() > now"
          }
        },

        "raceStart": { ".validate": "newData.isNumber() && !data.exists() && newData.val() === root.child('races').child($race).child('voorstel').child('t').val()" },
        "gen": { ".validate": "newData.isNumber()" },

        "startPlan": {
          ".validate": "!data.exists() && (newData.child('modus').val() === 'gelijk' || newData.child('modus').val() === 'achtervolging' || newData.child('modus').val() === 'lus')"
        },

        "lines": {
          "$lijn": {
            ".validate": "($lijn === 'start' || $lijn === 'finish') && newData.hasChildren(['a', 'b'])",
            "$punt": {
              ".validate": "($punt === 'a' || $punt === 'b') && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
            }
          }
        },

        "marks": {
          "$i": {
            ".validate": "newData.child('lat').isNumber() && newData.child('lng').isNumber()"
          }
        },

        "spel": {
          "start": { ".validate": "newData.isNumber()" },
          "eind": { ".validate": "newData.isNumber()" },
          "veld": {
            ".validate": "newData.hasChildren(['lat', 'lng', 'r'])",
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "r": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000" },
            "$other": { ".validate": false }
          },
          "schoten": {
            "$boot": {
              "$nr": {
                ".write": "auth != null && !data.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid && root.child('races').child($race).child('spel').child('start').exists() && !root.child('races').child($race).child('spel').child('eind').exists()",
                ".validate": "$nr.matches(/^[0-9]$/) && newData.hasChildren(['ts', 'lat', 'lng', 'koers'])",
                "ts": { ".validate": "newData.isNumber() && newData.val() >= root.child('races').child($race).child('spel').child('start').val() && newData.val() <= now + 60000" },
                "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
                "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
                "koers": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 360" },
                "groot": { ".validate": "newData.val() === true" },
                "breed": { ".validate": "newData.val() === true" },
                "voor": { ".validate": "newData.val() === true" },
                "raak": { "$doel": { ".validate": "newData.val() === true && $doel !== $boot && $doel.length <= 30" } },
                "$other": { ".validate": false }
              }
            }
          },
          "straf": {
            "$boot": {
              "$nr": {
                ".write": "auth != null && !data.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid && root.child('races').child($race).child('spel').child('start').exists() && !root.child('races').child($race).child('spel').child('eind').exists()",
                ".validate": "$nr.matches(/^[0-2]$/) && newData.isNumber() && newData.val() >= root.child('races').child($race).child('spel').child('start').val()"
              }
            }
          },
          "mijnen": {
            "$boot": {
              "$nr": {
                ".write": "auth != null && !data.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid && root.child('races').child($race).child('spel').child('start').exists() && !root.child('races').child($race).child('spel').child('eind').exists()",
                ".validate": "$nr.matches(/^[0-9]$/) && newData.hasChildren(['ts', 'lat', 'lng'])",
                "ts": { ".validate": "newData.isNumber() && newData.val() >= root.child('races').child($race).child('spel').child('start').val() && newData.val() <= now + 60000" },
                "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
                "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
                "$other": { ".validate": false }
              }
            }
          },
          "mijnraak": {
            "$boot": {
              "$mijn": {
                ".write": "auth != null && !data.exists() && root.child('races').child($race).child('claims').child($boot).val() === auth.uid && root.child('races').child($race).child('spel').child('start').exists() && !root.child('races').child($race).child('spel').child('eind').exists()",
                ".validate": "$mijn.length <= 40 && newData.isNumber() && newData.val() >= root.child('races').child($race).child('spel').child('start').val() && newData.val() <= now + 60000"
              }
            }
          },
          "buit": {
            "$nr": {
              ".write": "auth != null && !data.exists() && newData.child('boot').isString() && root.child('races').child($race).child('claims').child(newData.child('boot').val()).val() === auth.uid && root.child('races').child($race).child('spel').child('start').exists() && root.child('races').child($race).child('spel').child('veld').exists() && !root.child('races').child($race).child('spel').child('eind').exists()",
              ".validate": "$nr.matches(/^[0-9]{1,6}$/) && newData.hasChildren(['boot', 'ts'])",
              "boot": { ".validate": "newData.isString() && newData.val().length <= 30" },
              "ts": { ".validate": "newData.isNumber() && newData.val() >= root.child('races').child($race).child('spel').child('start').val() && newData.val() <= now + 60000" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },

        "results": {
          "$nr": {
            ".validate": "newData.hasChildren(['nr', 'ts'])",
            "naam": { ".validate": "newData.isString() && newData.val().length <= 60" }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
